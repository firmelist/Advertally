APP_NAME=Advertally
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local dev uses SQLite. For production switch to MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=advertally
# DB_USERNAME=advertally
# DB_PASSWORD=secret
DB_CONNECTION=mysql
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@advertally.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------- Advertally ----------
# Where new-lead alerts are emailed (comma-separated)
LEAD_ALERT_EMAILS=sales@advertally.com

# Admin user created by the seeder
ADMIN_EMAIL=admin@advertally.com
ADMIN_PASSWORD=ChangeMe@123

# WhatsApp Cloud API (Meta) — leave blank to disable WhatsApp alerts
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALERT_TO=
# Approved template names (utility category)
WHATSAPP_TEMPLATE_LEAD_ALERT=new_lead_alert
WHATSAPP_TEMPLATE_THANK_YOU=lead_thank_you

# Optional Slack incoming webhook for lead alerts
SLACK_LEAD_WEBHOOK=

# Google PageSpeed Insights API key (free tool uses it when present)
PAGESPEED_API_KEY=

# Cloudflare Turnstile (spam protection). Leave blank to rely on honeypot + rate limit.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Outbound webhook — every new lead is POSTed here (Zoho/HubSpot/Make/n8n)
LEAD_WEBHOOK_URL=

# Booking link used in auto-responders and "Book a call" buttons
BOOKING_URL=https://calendly.com/advertally/30min
