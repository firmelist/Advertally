APP_NAME=Advertally
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL (XAMPP locally, Hostinger in production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=advertally
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@advertally.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------- Advertally ----------
# Admin user created by the seeder (change before seeding production)
ADMIN_EMAIL=admin@advertally.com
ADMIN_PASSWORD=ChangeMe@123

# New-lead alert recipients (comma-separated)
LEAD_ALERT_EMAILS=hello@advertally.com
# Optional: Slack incoming webhook and an outbound webhook (HubSpot/Zoho/Make/n8n) for every new lead
SLACK_LEAD_WEBHOOK=
LEAD_WEBHOOK_URL=
BOOKING_URL=

# Cloudflare Turnstile — leave blank to rely on honeypot + time trap + rate limits
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics & tags — blank = not loaded. Loaded in production only, after cookie consent.
GTM_ID=
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
LINKEDIN_PARTNER_ID=
CLARITY_PROJECT_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# AI provider for report summaries and future AI features: none | openai | anthropic | gemini
# Keys stay on the server and are never sent to the browser.
AI_PROVIDER=none
AI_TIMEOUT=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
